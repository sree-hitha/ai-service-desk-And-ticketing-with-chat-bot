# Server
PORT=3000

# Auth
JWT_SECRET=change_this_to_a_long_random_secret

# Database: SQLite file, created automatically at project root as relay.db
# No install, no service, no password needed.

# Email (optional). Leave blank to fall back to console-log "sent" emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=support@relay.local
